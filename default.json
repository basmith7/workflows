{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "basmith7's shared Renovate preset. Repos opt in with renovate.json = {\"extends\": [\"github>basmith7/workflows\"]}.",
  "extends": ["config:recommended"],
  "timezone": "America/Phoenix",
  "schedule": ["before 6am on monday"],
  "enabledManagers": ["npm", "dockerfile", "github-actions", "pep621"],
  "automerge": true,
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "merge-commit",
  "semanticCommits": "disabled",
  "constraints": { "npm": "^11" },
  "hostRules": [
    {
      "hostType": "npm",
      "matchHost": "npm.pkg.github.com",
      "token": "{{ secrets.GH_PACKAGES_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "One weekly PR for every minor and patch update.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor and patch updates",
      "groupSlug": "minor-patch"
    },
    {
      "description": "Majors get their own PR and wait for a person.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Base images are never built by PR CI, so their updates wait for a person.",
      "matchManagers": ["dockerfile"],
      "groupName": "base images",
      "groupSlug": "base-images",
      "automerge": false
    },
    {
      "description": "A Node major moves templates/next-prisma and node-ci first; it opens only when ticked on the dashboard.",
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Callers track basmith7/workflows at @main on purpose; never pin or bump it.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["basmith7/workflows"],
      "enabled": false
    }
  ]
}
